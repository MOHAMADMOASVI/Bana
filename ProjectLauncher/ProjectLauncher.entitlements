<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off: servers need ~/.nvm, ~/.pyenv, ~/.composer, /tmp and the rest of the home folder.
	     To re-enable, set true and add network.server/client, files.user-selected.read-write,
	     files.bookmarks.app-scope (the code already handles a sandboxed run). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
